[Unit]
Description=Retry pending Huawei Telegram notifications
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/huawei-signin
ExecStart=/opt/huawei-signin/venv/bin/python /opt/huawei-signin/notify.py --flush
UMask=0077
TimeoutStartSec=4min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/huawei-signin/state
