[Unit]
Description=Huawei session read-only renewal experiment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/huawei-signin
ExecStart=/opt/huawei-signin/venv/bin/python /opt/huawei-signin/signin.py --refresh
ExecStopPost=/opt/huawei-signin/venv/bin/python /opt/huawei-signin/notify.py --refresh-failure
UMask=0077
TimeoutStartSec=3min
MemoryHigh=100M
MemoryMax=160M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/huawei-signin/state
Environment=PYTHONUNBUFFERED=1
